# ==============================================
# Konfigurasi Shopee Video Uploader Agent
# Salin file ini menjadi ".env" lalu isi nilainya
# ==============================================

# --- 9Router (di server kamu, OpenAI-compatible) ---
LLM_BASE_URL=http://192.168.1.10:20128/v1
LLM_API_KEY=isi-api-key-9router
LLM_MODEL=nama-model-vision-capable
# Contoh model gratis yg support vision via 9Router bisa dicek di dashboardnya.
# Agen WAJIB pakai model vision (dia "melihat" screenshot HP).

# --- ADB: HP Android (wireless) ---
# Format IP:PORT, lihat di HP: Developer options > Wireless debugging
ADB_DEVICE=192.168.1.20:5555

# --- Google Sheet antrean ---
SHEET_ID=1zl-X42GvJX10zpBHY2mmmjaqKttgO1J8gOD5VzXtmiw
GOOGLE_SA_JSON=service-account.json
WORKSHEET=Sheet1

# --- Batasan keamanan (anti deteksi) ---
MAX_UPLOADS_PER_DAY=8
MIN_DELAY_MIN=20
MAX_DELAY_MIN=45
ACTIVE_HOUR_START=7
ACTIVE_HOUR_END=21
MAX_RETRY=2

# --- Folder kerja lokal ---
WORK_DIR=work
